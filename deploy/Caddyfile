{$SITE_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 512KB
	}
	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto https
	}
	# No access log: it would persist raw client IPs (data minimisation). The app logs errors with request ids.
}
