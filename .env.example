# ════════════════════════════════════════════════════════════════════════════
# Shikor environment template. Copy to .env (local) — NEVER commit a filled file.
# In production, inject these from your host's secret store (or a SOPS/age file).
# The app refuses to boot in production with placeholder/weak/reused secrets.
# ════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
# Public origin users see. Must be https:// in production.
APP_URL=http://localhost:3000

# PostgreSQL 16+. Production: connect as the least-privilege runtime role (deploy/postgres/grants.sql).
DATABASE_URL=postgres://shikor:shikor@localhost:5432/shikor
DATABASE_POOL_MAX=10

# Secrets — generate each with:  openssl rand -hex 32   (two DIFFERENT values)
APP_SECRET=
ENCRYPTION_KEY=

# Email: console | file (dev/tests) | smtp (production)
EMAIL_TRANSPORT=console
EMAIL_FROM="Shikor <no-reply@your-domain.example>"
# e.g. smtps://USERNAME:PASSWORD@smtp.your-provider.example:465
SMTP_URL=
EMAIL_FILE_DIR=.mail-outbox

# Client IP header set by YOUR proxy. Behind Cloudflare: cf-connecting-ip (and firewall the origin to Cloudflare IPs).
TRUSTED_IP_HEADER=none
TRUSTED_PROXY_HOPS=1

# Optional: Cloudflare Turnstile on registration (free, privacy-friendly bot check)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: screen new passwords against Have I Been Pwned (k-anonymity; only 5 hash chars leave the server)
HIBP_CHECK=true

# Dev/test only: run background jobs inline instead of in the worker. Must be false in production.
JOBS_INLINE=true
JITSI_BASE_URL=https://meet.jit.si

# Published contacts (privacy policy, footer, security.txt)
GRIEVANCE_OFFICER_NAME="Grievance Officer"
GRIEVANCE_OFFICER_EMAIL=grievance@your-domain.example
SUPPORT_EMAIL=support@your-domain.example
SECURITY_EMAIL=security@your-domain.example

LOG_LEVEL=info
