# ══════════════════════════════════════════════════════════════════════════════
#  Shikor — environment configuration
#
#  Local development:  run `npm run setup`. It copies this file to .env, fills in
#                      fresh secrets, and locks the file to your user (mode 600).
#  Production:         inject these from your host's secret store (or a SOPS/age
#                      file). Never commit a filled-in copy — .env is git-ignored.
#
#  Check any environment at any time with `npm run doctor`.
#  The app refuses to start in production with missing, placeholder, weak or
#  reused secrets, so a misconfiguration fails loudly instead of silently.
# ══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
# The public origin users see. Must be https:// in production.
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ── Secrets (required) ────────────────────────────────────────────────────────
# Two DIFFERENT 64-character hex values. `npm run setup` generates them, or:
#   openssl rand -hex 32
# APP_SECRET signs sessions/CSRF and keys IP hashing. ENCRYPTION_KEY encrypts
# 2FA secrets at rest. Changing ENCRYPTION_KEY makes existing 2FA secrets
# unreadable — rotate it only with a planned re-enrolment.
APP_SECRET=
ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL 16+. The default matches `docker compose up -d`.
# Production: connect as the least-privilege runtime role (deploy/postgres/grants.sql).
DATABASE_URL=postgres://shikor:shikor@localhost:5432/shikor
DATABASE_POOL_MAX=10

# ── Email ─────────────────────────────────────────────────────────────────────
# console — print emails in the terminal (no services needed)
# smtp    — real delivery. Locally, `npm run setup` points this at Mailpit
#           (smtp://127.0.0.1:1025, inbox at http://localhost:8025).
# file    — write JSON files to EMAIL_FILE_DIR (automated tests)
EMAIL_TRANSPORT=console
EMAIL_FROM="Shikor <no-reply@your-domain.example>"
# Production example: smtps://USERNAME:PASSWORD@smtp.your-provider.example:465
SMTP_URL=
EMAIL_FILE_DIR=.mail-outbox

# ── Network ───────────────────────────────────────────────────────────────────
# The client-IP header set by YOUR reverse proxy, used for rate limits.
# Behind Cloudflare: cf-connecting-ip (and firewall the origin to Cloudflare IPs).
TRUSTED_IP_HEADER=none
TRUSTED_PROXY_HOPS=1

# ── Abuse protection (optional) ───────────────────────────────────────────────
# Cloudflare Turnstile on registration (free, privacy-friendly bot check).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Screen new passwords against Have I Been Pwned using k-anonymity
# (only the first 5 characters of a SHA-1 hash ever leave the server).
HIBP_CHECK=true

# ── Background jobs & video ───────────────────────────────────────────────────
# Development/tests only: run jobs inline instead of in the worker.
# Must be false in production — run `npm run worker` alongside the app.
JOBS_INLINE=true
JITSI_BASE_URL=https://meet.jit.si

# ── Published contacts (privacy policy, footer, security.txt) ────────────────
GRIEVANCE_OFFICER_NAME="Grievance Officer"
GRIEVANCE_OFFICER_EMAIL=grievance@your-domain.example
SUPPORT_EMAIL=support@your-domain.example
SECURITY_EMAIL=security@your-domain.example
